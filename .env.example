# GEMINI_API_KEY: Required for Gemini AI API calls, Vision fallback, and Google Search grounding.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OLLAMA_URL: Local Ollama server endpoint (default: http://127.0.0.1:11434)
OLLAMA_URL="http://127.0.0.1:11434"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
